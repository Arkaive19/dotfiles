// designed for presenting Vanilla Linux
// inspired from imstilllearnin's Vanilla Logo Ultra
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small"
  },
  "display": {
    "color": {
      "output": "cyan"
    },
    "separator": ""
  },
  "modules": [
    {
      "type": "kernel",
      "key": "┃ Kernel  --> ",
        "outputColor": "white",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "outputColor": "white",
      "key": "┃ Package --> ",
      "keyColor": "magenta"
    },
    {
      "type": "localip",
      "outputColor": "white",
      "key": "┃ IP      --> ",
      "keyColor": "magenta"
    },
    {
      "type": "memory",
      "format": "[{3}] {1} / {2}",
      "outputColor": "white",
      "key": "┃ RAM     --> ",
      "keyColor": "magenta"
    },
    {
      "type": "swap",
      "format": "[{3}] {1} / {2}",
       "outputColor": "white",
      "key": "┃ SWAP    --> ",
      "outputColor": "white",
      "keyColor": "magenta"
    },
    {
      "type": "disk",
      "format": "[{3}] {1} / {2} {9}",
      "key": "┃ Disk    --> ",
      "outputColor": "white",
      "keyColor": "magenta"
    },
    {
      "type": "battery",
      "format": "[{4}] {5}",
      "key": "┃ Battery --> ",
      "outputColor": "white",
      "keyColor": "magenta"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 9,
      "symbol": "circle"
    }
  ]
}
