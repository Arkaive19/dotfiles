/* import only colors from wal */
@import "~/.cache/wal/colors-rofi-dark.rasi"

configuration { 
    modi: "drun";
    show-icons: true;
    display-drun: "";
    drun-display-format: "{name}";
    font: "Product Sans 10";
    sidebar-mode: true;
}

/* override all style settings to ignore imported styles */
* {
    /* only keep colors from wal */
    background-color: @background;
    text-color: @foreground;

    selected-bg: @selected-normal-background;
    selected-fg: @selected-normal-foreground;

    active-background: @active-background;
    active-foreground: @active-foreground;

    urgent-background: @urgent-background;
    urgent-foreground: @urgent-foreground;
}

window { 
    border-radius: 7px;
    width: 37%;
    padding: 5px;
    border: 2px solid;
    border-color: @accent;
}

prompt {
    background-color: @button;
    text-color: @fg;
    enabled: true;
    padding: 0.5% 32px 0% -0.5%;
    font: "Product Sans 10";
}

entry { 
    placeholder: "Search";
    background-color: @button;
    placeholder-color: @fg;
    expand: true;
    padding: 0.15% 0% 0% 0%;
    text-color: @fg;
}

inputbar { 
    children: [prompt, entry];
    background-color: @button;
    border-radius: 6px;
    padding: 10px;
    border: 1px solid;
    border-color: @accent;
    expand: false;
}

listview { 
    columns: 4;
    lines: 3;
    layout: vertical;
    spacing: 5px;
    cycle: false;
    dynamic: true;
}

mainbox { 
    children: [inputbar, listview];
    spacing: 2%;
    padding: 2% 1% 2% 1%;
}

element { 
    orientation: vertical;
    padding: 2% 0% 2% 0%;
    border-radius: 4px;
}

element-icon { 
    size: 48px;
    horizontal-align: 0.5;
    text-color: none;
    background-color: none;
}

element-text { 
    horizontal-align: 0.5;
    vertical-align: 0.5;
    expand: true;
    margin: 0.5% 0.5% -0.5% 0.5%;
}

element-text, element-icon { 
    background-color: inherit;
    text-color: inherit;
}

element selected { 
    background-color: @selected-bg;
    border-radius: 6px;
    text-color: @selected-fg;
}

textbox-icon {
    expand:                      false;
    background-color:            transparent;
    text-color:                  inherit;
    str: "  ";
}

