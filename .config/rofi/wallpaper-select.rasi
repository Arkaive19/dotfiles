/* import only colors from wal */
@import "~/.cache/wal/colors-rofi-dark.rasi"


// Config //
configuration {
    modi:                        "drun";
    show-icons:                  true;
    drun-display-format:         "{icon}";
    font:                        "JetBrainsMono Nerd Font 10";
}



// Main //
window {
    enabled:                     true;
    fullscreen:                  false;
    transparency:                "real";
    cursor:                      "default";
    spacing:                     0em;
    padding:                     0em;
    border:                      0em;
    border-radius:               0em;
    border-color:                @main-bg;
    background-color:            @main-bg;
    width:                       100%;
    height:                      100%;
}
mainbox {
    enabled:                     true;
    orientation:                 horizontal;
    children:                    [ "dummy", "frame", "dummy" ];
    background-color:            transparent;
}
frame {
    children:                    [ "listview" ];
    background-color:            transparent;
}


// Lists //
listview {
    enabled:                     true;
    spacing:                     4em;
    padding:                     4em;
    columns:                     4;
    lines:                       1;
    dynamic:                     true;
    fixed-height:                false;
    fixed-columns:               true;
    reverse:                     true;
    cursor:                      "default";
    background-color:            transparent;
    text-color:                  @main-fg;
}
dummy {
    width:                       2em;
    expand:                      false;
    background-color:            transparent;
}


// Elements //
element {
    spacing: 0em;
    padding: 1em;
    border-radius: 1em; // optional rounded corners
    background-color: @selected-urgent-background;
    text-color: @main-fg;
}

element selected.normal {
    background-color:            @select-bg;
    text-color:                  @select-fg;
}
element-icon {
    expand: true;          // fills parent element
    size: 80%;            // scale to container
    vertical-align: 0.5;
    horizontal-align: 0.5;
    margin:0;
    border-radius: 2em;
    background-color: transparent;
}

element-text {
    enabled: false;
    visible: false;
    display: none;
    width: 0em;
    height: 0em;
    padding: 0em;
    margin: 0em;
}

