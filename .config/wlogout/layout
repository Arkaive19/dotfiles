{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Shutdown",
    "keybind" : "1"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Reboot",
    "keybind" : "2"
}
{
    "label" : "logout",
    "action" : "loginctl kill-session $XDG_SESSION_ID",
    "text" : "Logout",
    "keybind" : "3"
}
{
    "label" : "lock",
    "action" : "hyprlock &",
    "text" : "Lock",
    "keybind" : "4"
}
{
    "label" : "sleep",
    "action" : "systemctl suspend",
    "text" : "Sleep",
    "keybind" : "5"
}
{
    "label" : "hibernate",
    "action" : "systemctl hibernate",
    "text" : "hibernate",
    "keybind" : "6"
}







