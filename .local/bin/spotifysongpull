#!/usr/bin/env bash

PLAYLIST_URL="https://open.spotify.com/playlist/5YySV4fMfnRahWgXQXcKVJ"
MUSIC_DIR="/home/arkaive19/Music"

mkdir -p "$MUSIC_DIR"

ulimit -n 65535

echo "› Downloading playlist via spotdl (YouTube Music resolver)..."

spotdl download "$PLAYLIST_URL" \
  --output "$MUSIC_DIR/{artist} - {title}.{output-ext}" \
  --format mp3 \
  --bitrate 320k \
  --threads 1 \
  --overwrite skip \
  --user-auth

ulimit -n 1024
