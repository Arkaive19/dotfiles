#!/usr/bin/env bash

PLAYLIST_URL="https://open.spotify.com/playlist/5YySV4fMfnRahWgXQXcKVJ?si=rJv6KgliTT609BvCdsyTOg"
MUSIC_DIR="$HOME/Music"

mkdir -p "$MUSIC_DIR"

echo "› Downloading playlist via spotdl (YouTube Music resolver)..."

ulimit -n 65535

spotify_dl \
  -l "$PLAYLIST_URL" \
  -o "$MUSIC_DIR"

ulimit -n 1024
